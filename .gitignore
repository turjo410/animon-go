apps/mobile/android/local.properties
apps/mobile/**/*.g.dart
apps/mobile/**/*.freezed.dart

# Node (animon-identity-pilot)
animon-identity-pilot/node_modules/
animon-identity-pilot/.next/
animon-identity-pilot/.env
animon-identity-pilot/.env.local

# Secrets
.env
.env.*
!.env.example

