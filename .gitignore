/animon-web/
# twntis-film is an unrelated project — never touched from this repo.
/twntis-film/
/doc-ignored/

# Scratch / local only
/tmp/
.DS_Store
*.log

# Flutter / Dart (apps/mobile)
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
apps/mobile/build/
apps/mobile/*.iml
apps/mobile/ios/Pods/
